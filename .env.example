# Metromaker configuration. Copy this file to ".env" and adjust it:
#
#   cp .env.example .env
#
# Both docker-compose files read it.

# ---------------------------------------------------------------------------
# Website
# ---------------------------------------------------------------------------

# Port on your machine where the Metromaker website is reachable.
METROMAKER_PORT=3000

# ---------------------------------------------------------------------------
# Listen Together server (metroserver)
# ---------------------------------------------------------------------------

# docker-compose.yml (website only):
#   Address of the EXISTING metroserver that Metromaker should create its rooms
#   on. ws:// or wss://, the "/ws" path is added automatically when missing.
#   Your guests must point Metrolist's Listen Together at this same server
#   to join a room.
#
# docker-compose.with-metroserver.yml (website + own metroserver):
#   Leave this line as it is; it is ignored because Metromaker talks to the
#   bundled metroserver directly.
METROSERVER_URL=wss://metroserver.example.com/ws

# The Listen Together address shown to guests on the room page. Normally leave
# it empty:
#
# docker-compose.yml: guests are shown METROSERVER_URL and connect to that
# server directly.
#
# docker-compose.with-metroserver.yml: guests are shown the website's own
# address followed by /ws (for example wss://music.example.com/ws). Metromaker
# forwards that path to the bundled metroserver, so one domain is enough.
#
# Set it only if guests should use a different address than that.
METROSERVER_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Optional settings
# ---------------------------------------------------------------------------

# Name of the room host as shown to listeners in Metrolist.
HOST_NAME=Metromaker

# Maximum number of rooms at the same time. A metroserver accepts at most 32
# connections per address, so stay below that on a server you do not run.
MAX_ROOMS=20

# A room is closed after this many minutes without anyone on its page and
# without any listener in Metrolist.
ROOM_IDLE_MINUTES=180

# Set to "true" when Metromaker runs behind a reverse proxy (Caddy, nginx,
# Traefik, ...) so the X-Forwarded-For address of the visitor is used. Without
# it every guest counts as the proxy, and the metroserver stops accepting
# listeners after 32 connections from one address.
TRUST_PROXY=false

# Language and country for YouTube Music search results.
YTM_LANGUAGE=en
YTM_REGION=US
